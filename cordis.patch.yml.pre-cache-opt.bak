# Your patch layer for this dsh profile, applied after every bundle layer:
# a top-level YAML array of loader patch entries (id-targeted config
# overrides, disables, and insert lists; `!!js` expressions allowed).
- id: ui-theme
  name: "@deepseek-ai/dsh-client-ui-theme"
  config:
    preference: dark
- id: agent-preset-registry
  name: "@deepseek-ai/dsh-agent-preset-registry"
  config:
    default: standard
    selectedDefault: ptc
- id: agent-default-model
  name: "@deepseek-ai/dsh-agent-default-model"
  config:
    provider: ps-air-outer
    model: deepseek-v4-flash
    reasoningEffort: high
- id: ui-settings-account
  name: "@deepseek-ai/dsh-client-ui-settings-account"
  config:
    version: 1
    step: done
    purpose: development
    process: compact
    completion: completed
    usage: detailed
    developerTools: true
- id: ui-chat
  name: "@deepseek-ai/dsh-client-ui-chat"
  config:
    transcriptView: standard
    performanceUsage: detailed
- id: ui-settings
  name: "@deepseek-ai/dsh-client-ui-settings"
  config:
    enabled: true

# custom: ps.air-outer.com gateway route. The host speaks both an
# OpenAI-compatible and a native Anthropic Messages surface; this route uses
# the Anthropic one, because thinking blocks travel with their real
# signatures there instead of being re-synthesized as a "reasoning_content"
# field name. baseURL carries no /v1 suffix: the Anthropic SDK appends
# /v1/messages itself. The host is User-Agent gated, which the
# dsh-llm-pi-ai adapter carries (see the claudeCliUserAgent shim in its
# lib/index.js).
- id: llm-pi-ai
  name: "@deepseek-ai/dsh-llm-pi-ai"
  config:
    providers:
      ps-air-outer:
        displayName: PS Air Outer
        api: anthropic-messages
        baseURL: https://ps.air-outer.com
        apiKeyEnv: PS_AIR_OUTER_API_KEY
        models:
          - id: deepseek-v4-flash
            name: DeepSeek V4 Flash
            contextWindow: 131072
            maxTokens: 32768
            input:
              - text
              - image
            reasoningEfforts:
              off: null
              low: low
              medium: medium
              high: high
